# Copy to .env and adjust. Every setting is optional: with nothing set, OfferReady runs fully offline
# (rule-based reviews and scoring; AI rewrites fall back to templates).

# --- AI provider: openai | ollama | mock (offline). Students can override this in Settings.
LLM_PROVIDER=mock
# OpenAI (hosted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6-luna
OPENAI_REASONING_EFFORT_FAST=low
OPENAI_REASONING_EFFORT_SMART=medium
# Ollama (fully local): `ollama pull qwen2.5:7b-instruct`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_MODEL_SMART=qwen2.5:7b-instruct
LLM_TIMEOUT_S=90
INTERVIEW_SCORING_RUNS=3

# --- Voice interviews: browser (free, Chrome/Edge) | openai | whisper (self-hosted faster-whisper server)
STT_PROVIDER=browser
TTS_PROVIDER=browser
WHISPER_BASE_URL=http://localhost:8001/v1

# --- Storage and security. Keys are generated into DATA_DIR on first run; set them explicitly in production.
DATA_DIR=./data
# DATABASE_URL=postgresql://offerready:secret@localhost:5432/offerready
# SECRET_KEY=
# DATA_ENCRYPTION_KEY=
BASE_URL=http://localhost:8000
SESSION_DAYS=7
MAX_UPLOAD_MB=10
# true behind nginx/Caddy so rate limits use the real client IP
TRUST_PROXY=false

# --- Accounts
ADMIN_EMAIL=admin@msot.edu
# change before go-live
ADMIN_PASSWORD=admin12345
# creates demo@student.msot.edu / demo12345
SEED_DEMO=true

# --- Reviews
# optional read-only token: higher rate limit + pinned repos/contribution graph
GITHUB_TOKEN_FOR_REVIEWS=
PLAYWRIGHT_ENABLED=true
LEETCODE_ENABLED=true
MAX_REPO_MB=150

# --- Jobs (official APIs only; see docs/JOB_SOURCES.md)
JOB_REFRESH_HOURS=6
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# true: never call external job/review APIs (demo data only)
OFFLINE_MODE=false

# --- Background work
# false when running separate `python -m app.worker` processes
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=4

# --- Email reminders (optional; in-app notifications always work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=placements@msot.edu
